{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlopBar",
  "version": "0.1.0",
  "identifier": "dev.thelio.slopbar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "dock",
        "title": "SlopBar Ultra",
        "url": "index.html",
        "width": 160,
        "height": 48,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false
      },
      {
        "label": "panel",
        "title": "SlopBar Ultra",
        "url": "index.html",
        "width": 380,
        "height": 320,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        }
      },
      {
        "label": "switcher",
        "title": "SlopBar Ultra",
        "url": "switcher.html",
        "width": 440,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        }
      },
      {
        "label": "settings",
        "title": "SlopBar Ultra",
        "url": "settings.html",
        "width": 1000,
        "height": 700,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5M0Q4QThCNzVBOUEyMDQKUldRRW9xbDFpNG85V1FlWnB3SUlyYjVqa1JvaFJQSll2SmxGeUVaajZBRktlZSsva2grVUJKSjkK",
      "endpoints": [
        "https://github.com/layibabalola/slopbar-ultra/releases/download/ultra-latest/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
